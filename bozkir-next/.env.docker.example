# Docker Compose ortam değişkenleri — bu dosyayı `.env` olarak kopyalayın.
# (Yalnızca compose seviyesi; uygulama değişkenleri .env.local içinde.)

POSTGRES_USER=bozkir
POSTGRES_PASSWORD=degistir-bunu
POSTGRES_DB=bozkir

# Nesne depolama (SeaweedFS S3 — uyumluluk için key'ler opsiyoneldir)
S3_ACCESS_KEY=any
S3_SECRET_KEY=any
S3_BUCKET=bozkir-media

# Tarayıcının göreceği public medya yolu. nginx `/media/` -> storage proxy yapar.
S3_PUBLIC_BASE_URL=/media

# Public site adresi (build-time inline + runtime)
SITE_URL=https://www.bozkiragac.com

# Uygulama bayrakları
APP_TIME_ZONE=Europe/Istanbul
TRUSTED_PROXY=1
MAINTENANCE_MODE=0

# Bakım sayfası (nginx 502/504 statik sayfası) iletişim bilgileri.
# Konteyner başlarken şablona enjekte edilir → uygulama çökse de güncel kalır.
# Boş bırakılırsa compose içindeki varsayılanlar (siteConfig değerleri) kullanılır.
# MAINT_PHONE=+90 535 527 16 12
# MAINT_TEL=+905355271612
# MAINT_WHATSAPP=https://wa.me/905355271612
# MAINT_EMAIL=info@bozkiragac.com
# MAINT_HOURS_TR=Pazartesi – Cuma: 08:00 – 18:00 · Cumartesi: 08:00 – 14:00
# MAINT_HOURS_EN=Monday – Friday: 08:00 – 18:00 · Saturday: 08:00 – 14:00
# MAINT_HOURS_AR=الاثنين – الجمعة: 08:00 – 18:00 · السبت: 08:00 – 14:00
