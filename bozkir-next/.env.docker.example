# Docker Compose ortam değişkenleri — bu dosyayı `.env` olarak kopyalayın.
# (Yalnızca compose seviyesi; uygulama değişkenleri .env.local içinde.)

POSTGRES_USER=bozkir
POSTGRES_PASSWORD=degistir-bunu
POSTGRES_DB=bozkir

# Nesne depolama (SeaweedFS S3 — uyumluluk için key'ler opsiyoneldir)
S3_ACCESS_KEY=any
S3_SECRET_KEY=any
S3_BUCKET=bozkir-media

# Tarayıcının göreceği public medya yolu. nginx `/media/` -> storage proxy yapar.
S3_PUBLIC_BASE_URL=/media

# Public site adresi (build-time inline + runtime)
SITE_URL=https://www.bozkiragac.com
