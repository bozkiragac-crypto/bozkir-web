# Bozkır Ağaç — ortam değişken örneği (self-hosted full-stack)

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_ANALYTICS_ID=

# PostgreSQL
DATABASE_URL=postgresql://bozkir:bozkir@localhost:5432/bozkir
DB_POOL_MAX=10

# Oturum imzalama (en az 32 rastgele karakter)
AUTH_SECRET=

# 2FA TOTP secret şifreleme anahtarı (32 byte base64 veya 64 karakter hex).
# Boşsa AUTH_SECRET'tan türetilir; üretimde ayrı anahtar önerilir.
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

# Nesne depolama (S3 uyumlu)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=any
S3_SECRET_KEY=any
S3_BUCKET=bozkir-media
S3_PUBLIC_BASE_URL=http://localhost:8333/bozkir-media

# Admin erişimi veritabanındaki admin_users tablosundan gelir (beyaz liste yok).
# Yönetici oluşturmak için: npm run admin:reset -- --user <kullanıcı> --password-stdin --yes
# (hesap yoksa --create ekleyin; 2FA sıfırlamak için --reset-2fa)

# Teklif formu IP hız sınırı (nginx önünde de limit vardır).
QUOTE_RATE_LIMIT_MAX=5
RATE_WINDOW_MS=600000

# Spam koruması (DB destekli; IP/XFF'ten bağımsız çalışır).
QUOTE_PER_CONTACT_PER_HOUR=3
QUOTE_GLOBAL_PER_HOUR=30
QUOTE_GLOBAL_PER_DAY=200
QUOTE_DEDUPE_MINUTES=10
QUOTE_ATTACH_DAILY_COUNT=100

# Cloudflare Turnstile bot koruması (boşsa devre dışı).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Opsiyonel (varsayılanlar koddan gelir) ---
# Bakım modu (1 = site bakımda)
# MAINTENANCE_MODE=0
# Uygulama saat dilimi (gün gruplaması)
# APP_TIME_ZONE=Europe/Istanbul
# S3 istek zaman aşımı (ms)
# S3_REQUEST_TIMEOUT_MS=8000
# DB sorgu zaman aşımları (ms)
# DB_STATEMENT_TIMEOUT_MS=8000
# DB_QUERY_TIMEOUT_MS=10000
# Webhook HMAC imzası
# WEBHOOK_SECRET=
# Turnstile fail-closed (üretimde 1 önerilir)
# TURNSTILE_FAIL_CLOSED=0
