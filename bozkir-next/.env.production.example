# Örnek üretim ortam değişkenleri (VPS / Docker) — .env.local olarak kopyalayın.
NEXT_PUBLIC_SITE_URL=https://www.bozkiragac.com
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_ANALYTICS_ID=

# PostgreSQL
DATABASE_URL=postgresql://bozkir:GUCLU_SIFRE@db:5432/bozkir
DB_POOL_MAX=10
# Sorgu zaman aşımları (ms) — askıda kalan sorguları keser.
DB_STATEMENT_TIMEOUT_MS=8000
DB_QUERY_TIMEOUT_MS=10000

# Oturum imzalama (en az 32 rastgele karakter; uygulama min 16 ister)
# Güçlü değer üret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# İlk kurulumda admin hesabını entrypoint otomatik oluşturur (taze DB'de admin YOK).
# Doldurunca: bozkir kullanıcısı (owner) verilen parolayla oluşturulur/güncellenir.
# İlk girişten sonra panelden parolayı değiştirin ve 2FA'yı açın. Boşsa admin oluşturulmaz.
ADMIN_SEED_USERNAME=bozkir
ADMIN_SEED_PASSWORD=

# Nesne depolama (S3 uyumlu: SeaweedFS)
S3_ENDPOINT=http://storage:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=any
S3_SECRET_KEY=any
S3_BUCKET=bozkir-media
# Tarayıcının göreceği public medya adresi. Docker/nginx kurulumunda `/media`
# (nginx /media/ -> storage proxy yapar). Harici CDN kullanılırsa tam URL verin.
S3_PUBLIC_BASE_URL=/media
# S3 istek zaman aşımı (ms).
S3_REQUEST_TIMEOUT_MS=8000

# Admin erişimi veritabanındaki admin_users tablosundan gelir (beyaz liste yok).
# Yönetici oluşturmak için: npm run db:seed -- <kullanıcı> <şifre>
# veya yukarıdaki ADMIN_SEED_PASSWORD ile otomatik seed.

# --- Opsiyonel ---
# Bakım modu (1 = site bakımda)
MAINTENANCE_MODE=0
# Sürüm etiketi (health ucu ve loglar için; CI'da GIT_SHA verilebilir)
APP_VERSION=prod
# Güvenilir proxy arkasında X-Forwarded-For güveni (1 = evet, varsayılan)
TRUSTED_PROXY=1
# (Harici hata izleme entegre değildir; uygulama hataları sunucu loglarına yazılır.)
# Ek medya host'ları (next/image remotePatterns; virgülle ayrılır)
NEXT_PUBLIC_MEDIA_HOSTS=

# --- Spam / kötüye kullanım koruması ---
# Teklif formu IP hız sınırı (nginx önünde de limit vardır).
QUOTE_RATE_LIMIT_MAX=5
RATE_WINDOW_MS=600000
# Kişi başı / global limitler (DB destekli; sahte XFF ile atlatılamaz).
QUOTE_PER_CONTACT_PER_HOUR=3
QUOTE_GLOBAL_PER_HOUR=30
QUOTE_GLOBAL_PER_DAY=200
QUOTE_DEDUPE_MINUTES=10
QUOTE_ATTACH_DAILY_COUNT=100
# Cloudflare Turnstile bot koruması (boşsa devre dışı).
# Anahtarlar: https://dash.cloudflare.com/ -> Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 1 = Cloudflare'e ulaşılamazsa isteği reddet (fail-closed). Üretimde 1 önerilir.
TURNSTILE_FAIL_CLOSED=1

# Webhook (site_settings.webhookUrl) HMAC imzası; tanımlıysa X-Bozkir-Signature eklenir.
WEBHOOK_SECRET=

# --- Gelişmiş / opsiyonel (varsayılanlar koddan gelir) ---
# Middleware bakım durumunu iç ağdan okur (docker'da varsayılan yeterli).
# INTERNAL_APP_URL=http://127.0.0.1:3000
# Yedek durumu kartı için yedek dizini.
# BACKUP_DIR=./backups
# DB bağlantı zaman aşımları (ms).
# DB_CONNECT_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=30000
# Giriş deneme limiti + kilitleme süresi (dakika).
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
# Bellek-içi hız sınırlayıcı kapasitesi.
# RATE_MAX_HITS=20
# RATE_MAX_KEYS=10000
# 1 = oturum çerezine Secure bayrağını zorla (TLS arkasında önerilir).
# AUTH_COOKIE_SECURE=1
# Admin seed kullanıcı adı (scripts/seed-admin.mjs; varsayılan: bozkir).
# ADMIN_SEED_USERNAME=bozkir
