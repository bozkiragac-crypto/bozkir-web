# Örnek üretim ortam değişkenleri (VPS / Docker) — .env.local olarak kopyalayın.
NEXT_PUBLIC_SITE_URL=https://www.bozkiragac.com
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_ANALYTICS_ID=

# PostgreSQL
DATABASE_URL=postgresql://bozkir:GUCLU_SIFRE@db:5432/bozkir
DB_POOL_MAX=10

# Oturum imzalama (en az 32 rastgele karakter)
# Güçlü değer üret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Nesne depolama (S3 uyumlu: SeaweedFS)
S3_ENDPOINT=http://storage:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=any
S3_SECRET_KEY=any
S3_BUCKET=bozkir-media
# Tarayıcının göreceği public medya adresi (nginx ters proxy önerilir):
S3_PUBLIC_BASE_URL=https://www.bozkiragac.com/media

# Admin erişimi veritabanındaki admin_users tablosundan gelir (beyaz liste yok).
# Yönetici oluşturmak için: npm run admin:reset -- <kullanıcı> <şifre>

# --- Opsiyonel ---
# Bakım modu (1 = site bakımda)
MAINTENANCE_MODE=0
# Sürüm etiketi (health ucu ve loglar için; CI'da GIT_SHA verilebilir)
APP_VERSION=prod
# Güvenilir proxy arkasında X-Forwarded-For güveni (1 = evet, varsayılan)
TRUSTED_PROXY=1
# Hata izleme (opsiyonel; boşsa devre dışı)
SENTRY_DSN=
# Ek medya host'ları (next/image remotePatterns; virgülle ayrılır)
NEXT_PUBLIC_MEDIA_HOSTS=

# --- Spam / kötüye kullanım koruması ---
# Teklif formu IP hız sınırı (nginx önünde de limit vardır).
QUOTE_RATE_LIMIT_MAX=5
RATE_WINDOW_MS=600000
# Kişi başı / global limitler (DB destekli; sahte XFF ile atlatılamaz).
QUOTE_PER_CONTACT_PER_HOUR=3
QUOTE_GLOBAL_PER_HOUR=30
QUOTE_GLOBAL_PER_DAY=200
QUOTE_DEDUPE_MINUTES=10
QUOTE_ATTACH_DAILY_COUNT=100
# Cloudflare Turnstile bot koruması (boşsa devre dışı).
# Anahtarlar: https://dash.cloudflare.com/ -> Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
