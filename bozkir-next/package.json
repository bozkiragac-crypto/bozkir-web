{
  "name": "bozkir-next",
  "private": true,
  "version": "0.1.0",
  "description": "Bozkır Ağaç — yeni nesil dijital malzeme showroom'u (Next.js App Router)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "analyze": "cross-env ANALYZE=true next build",
    "format": "prettier --write .",
    "db:seed": "node scripts/seed-admin.mjs",
    "db:push": "drizzle-kit push",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed-content": "node scripts/seed-content-i18n.mjs",
    "db:seed-meta": "node scripts/seed-catalog-meta.mjs",
    "admin:reset": "node scripts/reset-admin.mjs",
    "storage:init": "node scripts/init-storage.mjs",
    "media:normalize": "node scripts/normalize-media-urls.mjs",
    "import:missing-images": "node scripts/import-missing-images.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^3.9.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "gsap": "^3.13.0",
    "jose": "^6.2.12",
    "lenis": "^1.1.18",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "nodemailer": "^10.0.13",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.6.0",
    "three": "^0.171.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "^15.1.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.171.0",
    "@vitest/coverage-v8": "^5.0.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.5.28",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
